includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    # The FFI/ONNX extension can crash phpstan's parallel workers; run single-process.
    parallel:
        maximumNumberOfProcesses: 1
